{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "workspace_inventory_version",
    "org",
    "repos"
  ],
  "properties": {
    "workspace_inventory_version": {
      "type": "integer"
    },
    "org": {
      "type": "string"
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "manifest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "org": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "manifest": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["active", "candidate", "held", "deprecated"]
          },
          "authority_role": {
            "type": "string"
          },
          "boundary_notes": {
            "type": "string"
          },
          "related_repos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optional_layer": {
            "type": "boolean"
          },
          "canonical_source_ref": {
            "type": "string"
          },
          "provides": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
