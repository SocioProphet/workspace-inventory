{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "workspace_inventory_version",
    "org",
    "repos"
  ],
  "properties": {
    "workspace_inventory_version": {
      "type": "integer"
    },
    "org": {
      "type": "string"
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "manifest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "manifest": {
            "type": "string"
          },
          "provides": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}